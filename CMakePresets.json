{
  "version": 6,
  "configurePresets": [
    {
      "name": "desktop-release",
      "displayName": "Desktop Release (Qt 6.12.0)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/desktop-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [{"name": "desktop-release", "configurePreset": "desktop-release"}],
  "testPresets": [{"name": "desktop-release", "configurePreset": "desktop-release", "output": {"outputOnFailure": true}}]
}
